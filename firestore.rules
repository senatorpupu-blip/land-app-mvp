rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }
    
    function isSeller() {
      return isAuthenticated() && (getUserData().role == 'seller' || getUserData().role == 'admin');
    }
    
    function isBuyer() {
      return isAuthenticated();
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isNotBlocked() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        getUserData().isBlocked != true;
    }
    
    // Plots collection
    // NOTE: Direct create is DISABLED - use createLandPlot Cloud Function instead
    match /plots/{plotId} {
      // Buyers can read approved plots
      // Sellers can read their own plots (any status)
      // Admins can read all plots
      allow read: if isAdmin() || 
        (resource.data.status == 'approved' && resource.data.status != 'deleted') ||
        (isAuthenticated() && resource.data.ownerId == request.auth.uid);
      
      // Direct create is DISABLED - must use createLandPlot Cloud Function
      allow create: if false;
      
      // Owners can update their own plots (except status field)
      // Admins can update any plot including status
      allow update: if isAdmin() ||
        (isAuthenticated() && 
         isNotBlocked() &&
         resource.data.ownerId == request.auth.uid &&
         request.resource.data.status == resource.data.status &&
         request.resource.data.ownerId == resource.data.ownerId);
      
      // Only owners can soft-delete their own plots, or admins
      // Soft delete: set status="deleted"
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.ownerId == request.auth.uid);
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own profile
      // Admins can read all profiles
      allow read: if isAdmin() || isOwner(userId);
      
      // Users can create their own profile on first login
      allow create: if isOwner(userId) && 
        request.resource.data.role in ['buyer', 'seller'] &&
        request.resource.data.isBlocked == false;
      
      // Users can update their own profile (except role and isBlocked)
      // Admins can update any profile including role and isBlocked
      allow update: if isAdmin() ||
        (isOwner(userId) && 
         request.resource.data.role == resource.data.role &&
         request.resource.data.isBlocked == resource.data.isBlocked);
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }
    
    // Chats collection
    match /chats/{chatId} {
      // Participants can read their chats
      allow read: if isAuthenticated() && 
        isNotBlocked() &&
        (resource.data.ownerId == request.auth.uid || 
         resource.data.clientId == request.auth.uid);
      
      // Authenticated non-blocked users can create chats
      allow create: if isAuthenticated() && 
        isNotBlocked() &&
        (request.resource.data.ownerId == request.auth.uid || 
         request.resource.data.clientId == request.auth.uid);
      
      // Participants can update their chats
      allow update: if isAuthenticated() && 
        isNotBlocked() &&
        (resource.data.ownerId == request.auth.uid || 
         resource.data.clientId == request.auth.uid);
      
      // Messages subcollection
      match /messages/{messageId} {
        // Chat participants can read messages
        allow read: if isAuthenticated() && 
          isNotBlocked() &&
          (get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid ||
           get(/databases/$(database)/documents/chats/$(chatId)).data.clientId == request.auth.uid);
        
        // Chat participants can create messages
        allow create: if isAuthenticated() && 
          isNotBlocked() &&
          request.resource.data.senderId == request.auth.uid &&
          (get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid ||
           get(/databases/$(database)/documents/chats/$(chatId)).data.clientId == request.auth.uid);
        
        // Sender can update their own messages (for read status)
        allow update: if isAuthenticated() && 
          isNotBlocked() &&
          (get(/databases/$(database)/documents/chats/$(chatId)).data.ownerId == request.auth.uid ||
           get(/databases/$(database)/documents/chats/$(chatId)).data.clientId == request.auth.uid);
      }
    }
    
    // Reports collection
    match /reports/{reportId} {
      // Only admins can read reports
      allow read: if isAdmin();
      
      // Authenticated non-blocked users can create reports
      allow create: if isAuthenticated() && 
        isNotBlocked() &&
        request.resource.data.reporterId == request.auth.uid;
      
      // Only admins can update reports
      allow update: if isAdmin();
      
      // Only admins can delete reports
      allow delete: if isAdmin();
    }
    
    // Oblast Centers collection (read-only reference data)
    match /oblastCenters/{oblastId} {
      // Anyone can read oblast centers (public reference data)
      allow read: if true;
      
      // Only admins can create/update/delete oblast centers
      allow create, update, delete: if isAdmin();
    }
    
    // Pricing Rules collection (read-only reference data)
    match /pricingRules/{ruleId} {
      // Anyone can read pricing rules (needed for price calculations)
      allow read: if true;
      
      // Only admins can create/update/delete pricing rules
      allow create, update, delete: if isAdmin();
    }
    
    // Land Analytics collection (read-only analytics data)
    match /landAnalytics/{analyticsId} {
      // Anyone can read analytics (public reference data)
      allow read: if true;
      
      // Only Cloud Functions can write (no direct client writes)
      allow create, update, delete: if false;
    }
    
    // News collection
    match /news/{articleId} {
      // Helper function to check if user is admin or manager
      function isAdminOrManager() {
        return isAuthenticated() && 
          (getUserData().role == 'admin' || getUserData().role == 'manager');
      }
      
      // Public can read only published articles
      // Admin/Manager can read all articles (any status)
      allow read: if resource.data.status == 'published' || isAdminOrManager();
      
      // Only admin/manager can create articles
      // NOTE: Prefer using createNewsArticle Cloud Function for validation
      allow create: if isAdminOrManager() &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.shortDescription.size() <= 500 &&
        request.resource.data.content.size() <= 50000 &&
        request.resource.data.authorId == request.auth.uid;
      
      // Only admin/manager can update articles
      allow update: if isAdminOrManager() &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.shortDescription.size() <= 500 &&
        request.resource.data.content.size() <= 50000;
      
      // Only admin/manager can delete (soft delete via status='archived')
      allow delete: if isAdminOrManager();
    }
  }
}
