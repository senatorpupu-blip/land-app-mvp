# Firebase Configuration
# Get these values from your Firebase Console: https://console.firebase.google.com
# Go to Project Settings > General > Your apps > SDK setup and configuration
#
# IMPORTANT: Enable these providers in Firebase Console > Authentication > Sign-in method:
# - Email/Password
# - Phone (requires billing account for SMS)
#
# Storage bucket format - check Firebase Console > Storage for the correct value:
# - your_project_id.appspot.com (legacy/common format)
# - your_project_id.firebasestorage.app (new format)

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Note: Google Maps API key is configured in app.json for native builds
# The key must be set in:
# - expo.ios.config.googleMapsApiKey
# - expo.android.config.googleMaps.apiKey
# After changing the key, run: npx expo prebuild && npx expo run:ios
